# Copiar a .env.local y completar con los datos del proyecto de Supabase
# (Project Settings → Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Dirección pública de la app (sin barra al final). En local podés usar http://localhost:3000;
# en Vercel, https://turnopy.vercel.app (o el dominio propio cuando lo tengas).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
